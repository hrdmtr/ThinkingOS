# Thinking OS - 環境変数サンプル
#
# 実際の値を書いたファイルはコミットしないこと。
# 本番（VPS）では /opt/thinking-os/shared/.env に実値を設置する
# （infra/systemd/thinking-os.service が EnvironmentFile として読み込む。パーミッション600）。
# ローカル開発では、このファイルを .env としてコピーして使う:
#   cp .env.example .env
#
# 参照: docs/vps-architecture.md

# --- アプリ実行モード ---
NODE_ENV=production

# --- サーバー ---
# Fastifyのリッスンポート。Caddyはこのポートへリバースプロキシする（infra/Caddyfile参照）。
# 外部公開しない前提のため 127.0.0.1 のみでリッスンする実装にすること。
PORT=3000

# --- Anthropic API ---
# 会話ログからのノード/エッジ抽出（docs/step5-build-plan.md 1章）に使う。
# リポジトリ・ログに出力しないこと（docs/vps-architecture.md 8章）。
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- データベース（SQLite） ---
# 本番: /opt/thinking-os/shared/data/thinkingos.sqlite（gitに含めない、パーミッション600）
# ローカル開発: リポジトリ配下の適当な場所（.gitignore対象）でよい
DATABASE_PATH=./data/thinkingos.sqlite

# --- Basic認証（Caddy側で使用。infra/Caddyfile・infra/shared/caddy.env参照） ---
# 注意: アプリ本体（Node/Fastify）はBasic認証を扱わない。
# Caddyのbasic_authディレクティブは平文パスワードではなく bcryptハッシュ を要求するため、
# BASIC_AUTH_PASSWORD はここでは「ハッシュ生成前の元の値をどこかに控えておく用」の参考値であり、
# 実際にCaddyへ渡すのは `caddy hash-password` で生成した BASIC_AUTH_PASSWORD_HASH の方。
# 本番でのCaddy用の実値は .env ではなく /opt/thinking-os/shared/caddy.env に置く
# （infra/provisioning/setup.sh が雛形を作成する）。
BASIC_AUTH_USER=thinkingos
BASIC_AUTH_PASSWORD_HASH=REPLACE_WITH_OUTPUT_OF_caddy_hash-password

# --- バックアップ（infra/backup/backup.sh が参照） ---
# age の公開鍵（受信者）。秘密鍵は手元PC側にのみ保管し、VPSには置かない。
THINKING_OS_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_YOUR_PUBLIC_KEY
THINKING_OS_DB_PATH=/opt/thinking-os/shared/data/thinkingos.sqlite
THINKING_OS_BACKUP_DIR=/opt/thinking-os/shared/backups
THINKING_OS_BACKUP_RETENTION=7

# --- デプロイ・ドメイン（参考。GitHub SecretsとCaddy用envに実値を置くため、
#     アプリの.envとしては通常不要。ローカルでの動作確認用にコメントとして残す） ---
# DOMAIN=example.com
