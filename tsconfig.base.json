{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@thinking-os/shared": ["../../packages/shared/src/index.ts"],
      "@thinking-os/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
